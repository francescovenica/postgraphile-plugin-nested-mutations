{
  "name": "postgraphile-plugin-nested-mutations",
  "version": "2.0.0",
  "description": "Nested mutations plugin for PostGraphile V5",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "url": "git+https://github.com/mlipscombe/postgraphile-plugin-nested-mutations.git",
    "type": "git"
  },
  "author": "Mark Lipscombe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mlipscombe/postgraphile-plugin-nested-mutations/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "scripts/test vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "postgraphile": "^5.0.0"
  },
  "devDependencies": {
    "@graphile/simplify-inflection": "^9.0.0",
    "@graphql-inspector/core": "^6.0.0",
    "pg": "^8.23.1",
    "postgraphile": "5.1.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "prettier": {
    "trailingComma": "all",
    "semi": true,
    "singleQuote": true,
    "arrowParens": "always"
  }
}
